# ==============================================================================
# BENTIAN ERP BRIDGE - CONFIGURACIÓN DE DESPLIEGUE WEB DESATENDIDO (.env.deploy)
# ==============================================================================
# Copia este archivo como .env.deploy y completa con tus credenciales de hosting.
# Este archivo está protegido en .gitignore para que nunca se suba al repositorio.
# ==============================================================================

# 1. PROTOCOLO DE TRANSFERENCIA
# Valores soportados: 'ftps' (recomendado para Plesk / cPanel), 'sftp' (para servidores SSH), o 'ftp'
DEPLOY_PROTOCOL=ftps

# 2. DATOS DEL SERVIDOR REMOTO
DEPLOY_HOST=www.suministrosrubio.com
DEPLOY_PORT=21
DEPLOY_USER=tu_usuario_ftp_o_ssh
DEPLOY_PASSWORD=tu_contraseña_segura

# Si usas SFTP con clave privada en lugar de contraseña (opcional):
# DEPLOY_KEY_PATH=C:/Users/TuUsuario/.ssh/id_ed25519

# 3. DIRECTORIO REMOTO DESTINO
# En Plesk habitualmente es '/httpdocs', en cPanel es '/public_html', en VPS '/var/www/html'
DEPLOY_REMOTE_DIR=/httpdocs

# 4. DIRECTORIO LOCAL CON LOS ARCHIVOS COMPILADOS
# Ruta relativa o absoluta a la carpeta dist de Angular / React / Vue / HTML
DEPLOY_LOCAL_DIR=../API/web/web/dist/fedeweb/browser

# 5. SUBIDA AUTOMÁTICA DEL CONECTOR PHP (erp-bridge-endpoint.php)
# 'true' sube erp-bridge-endpoint.php a la raíz de DEPLOY_REMOTE_DIR, 'false' para omitir
DEPLOY_INCLUDE_ENDPOINT=true
DEPLOY_ENDPOINT_SOURCE=erp-bridge-endpoint.php

# 6. VERIFICACIÓN AUTOMÁTICA TRAS EL DESPLIEGUE
# URL pública para comprobar que el sitio y el conector responden tras subir los archivos
DEPLOY_VERIFY_URL=https://www.suministrosrubio.com/erp-bridge-endpoint.php?action=ping
