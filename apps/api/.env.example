# ==============================================================================
# BENTIAN ERP BRIDGE — CONFIGURACIÓN DEL SERVIDOR API Y BASE DE DATOS
# ==============================================================================

PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (OPCIÓN A: SUPABASE CLOUD — RECOMENDADA PARA PRODUCCIÓN)
# ------------------------------------------------------------------------------
# En Supabase (Dashboard -> Settings -> Database -> Connection string -> URI):
# Usa el Session Pooler (puerto 5432) o Transaction Pooler (puerto 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DB_SSL=true

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (OPCIÓN B: POSTGRESQL LOCAL DOCKER — DESARROLLO)
# ------------------------------------------------------------------------------
# Si no defines DATABASE_URL, el sistema usará estos valores por defecto:
DB_HOST=localhost
DB_PORT=5434
DB_DATABASE=Factusol
DB_USER=postgres
DB_PASSWORD=123456789

# ------------------------------------------------------------------------------
# 2. FACTURACIÓN Y MONETIZACIÓN (STRIPE)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 3. DISTRIBUCIÓN DE ACTUALIZACIONES AUTOMÁTICAS
# ------------------------------------------------------------------------------
# URL pública o relativa donde los agentes descargan ejecutables de releases
RELEASES_DOWNLOAD_BASE_URL=/releases
CORE_API_URL=https://api.bentian.es
