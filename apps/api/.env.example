# ==============================================================================
# BENTIAN ERP BRIDGE — CONFIGURACIÓN DEL SERVIDOR API Y BASE DE DATOS
# ==============================================================================

PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (OPCIÓN A: SUPABASE CLOUD — RECOMENDADA PARA PRODUCCIÓN)
# ------------------------------------------------------------------------------
# En Supabase (Dashboard -> Settings -> Database -> Connection string -> URI):
# Usa el Session Pooler (puerto 5432) o Transaction Pooler (puerto 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DB_SSL=true

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (OPCIÓN B: POSTGRESQL LOCAL DOCKER — DESARROLLO)
# ------------------------------------------------------------------------------
# Si no defines DATABASE_URL, el sistema usará estos valores por defecto:
DB_HOST=localhost
DB_PORT=5434
DB_DATABASE=Factusol
DB_USER=postgres
DB_PASSWORD=123456789

# ------------------------------------------------------------------------------
# 2. SECRETOS CRIPTOGRÁFICOS DE SEGURIDAD (OBLIGATORIOS EN PRODUCCIÓN)
# ------------------------------------------------------------------------------
# Deben tener al menos 32 caracteres criptográficos aleatorios (ej: openssl rand -base64 32)
ADMIN_JWT_SECRET=reemplazar_con_un_secreto_criptografico_de_al_menos_32_caracteres_aleatorios
LICENSE_JWT_SECRET=reemplazar_con_un_secreto_criptografico_de_al_menos_32_caracteres_aleatorios

# Clave privada Ed25519 para firma asimétrica de licencias y proofs (mínimo 32 caracteres o PEM)
LICENSE_SIGNING_PRIVATE_KEY=reemplazar_con_clave_privada_ed25519_en_base64_o_pem

# Secreto para registro de partners revendedores (mínimo 16 caracteres)
PARTNER_SECRET=reemplazar_con_secreto_partner_min_16_caracteres

# ------------------------------------------------------------------------------
# 3. FACTURACIÓN Y MONETIZACIÓN (STRIPE)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 4. NOTIFICACIONES TRANSACCIONALES POR EMAIL (RESEND)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL_FROM=notificaciones@suministrosrubio.com

# ------------------------------------------------------------------------------
# 5. DISTRIBUCIÓN DE ACTUALIZACIONES AUTOMÁTICAS Y URLs
# ------------------------------------------------------------------------------
# URL pública o relativa donde los agentes descargan ejecutables de releases
RELEASES_DOWNLOAD_BASE_URL=/releases
CORE_API_URL=https://bridge.cristianjm.com
DASHBOARD_URL=https://bridge.cristianjm.com/dashboard
