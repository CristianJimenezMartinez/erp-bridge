{
  "name": "@erp-bridge/api",
  "version": "0.3.7",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:landing": "ts-node scripts/build-landing.ts",
    "build:dashboard": "ts-node scripts/build-dashboard.ts",
    "build:cities": "ts-node scripts/generate-city-pages.ts",
    "build:docs": "ts-node scripts/build-docs.ts",
    "build": "ts-node scripts/build-landing.ts && ts-node scripts/build-dashboard.ts && ts-node scripts/generate-city-pages.ts && ts-node scripts/build-docs.ts && tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "ts-node test/license-api.test.ts && ts-node test/update-api.test.ts && ts-node test/agent-monitor.test.ts && ts-node test/auth-security.test.ts && ts-node test/org-scope.test.ts && ts-node test/docs-static.test.ts"
  },
  "dependencies": {
    "@erp-bridge/connector-factusol": "workspace:*",
    "@erp-bridge/connector-prestashop": "workspace:*",
    "@erp-bridge/connector-simplygest": "workspace:*",
    "@erp-bridge/connector-woocommerce": "workspace:*",
    "@erp-bridge/core": "workspace:*",
    "@erp-bridge/sdk": "workspace:*",
    "@erp-bridge/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  }
}
